{
  "extends": "@repo/typescript-config/vue",
  "vueCompilerOptions": {
    "plugins": ["@vue/language-plugin-pug"]
  },
  "compilerOptions": {
    "baseUrl": ".",
    "types": ["@repo/service", "@repo/service/common"],
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src/**/*.d.ts", "src/**/*.ts", "src/**/*.tsx", "src/**/*.vue", "./*.config.ts"],
  "exclude": ["node_modules"]
}
